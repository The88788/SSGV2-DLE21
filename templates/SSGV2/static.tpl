<article class="panel staticpage">
	<div class="section-heading">
		<div>
			<h1>{description}</h1>
			<p class="static-meta">
				<span class="meta-item" title="Просмотров: {views}"><svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg>{views}</span>
				<span class="meta-dot" aria-hidden="true"></span>
				<time class="meta-item"><svg class="icon" aria-hidden="true"><use href="#i-clock"></use></svg>{date}</time>
			</p>
		</div>
		<div class="static-tools">
			[print-link]<span class="soft-button"><svg class="icon" aria-hidden="true"><use href="#i-file"></use></svg><span>Версия для печати</span></span>[/print-link]
			[edit]<span class="soft-button"><svg class="icon" aria-hidden="true"><use href="#i-edit"></use></svg><span>Редактировать</span></span>[/edit]
		</div>
	</div>
	<div class="story-text text">{static}</div>
	{pages}
</article>
