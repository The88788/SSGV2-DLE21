<!DOCTYPE html>
<html data-theme="light" lang="ru" dir="ltr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, follow">
	<link rel="icon" href="{THEME}/images/favicon.svg" type="image/svg+xml">
	<link href="{THEME}/css/print.css" type="text/css" rel="stylesheet">
	<title>Версия для печати — {description}</title>
</head>
<body class="printpage">
	<div class="printpage__top"><a href="{THEME}/../../">На главную сайта</a> / {description}</div>
